# ---------------------------------------------------------------------------
#  Ignore rules — keeps secrets, build output and local noise out of Git
#  https://git-scm.com/docs/gitignore
# ---------------------------------------------------------------------------

# --- Secrets & credentials (NEVER commit these) ---------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
secrets.json
secrets/
credentials.json
service-account*.json
*.keystore
id_rsa
id_ed25519
.npmrc
.netrc
.netlify.toml.local
.vercel/*.json
.firebase-adminsdk-*.json
database.sql
dump.sql
*.sqlite
*.sqlite3
*.db

# --- Dependencies ---------------------------------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions
vendor/

# --- Build output ---------------------------------------------------------
dist/
dist-ssr/
build/
out/
.vite/
.cache/
*.tsbuildinfo
next/
.nuxt/
.output/

# --- Logs -----------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*

# --- Caches & tooling -----------------------------------------------------
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache/
.turbo/
.temp/
.tmp/
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# --- Editors & OS ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Local-only asset scratch space ---------------------------------------
# `npm run sync:assets` copies real files from src/data/assets.js into
# public/. If you keep large masters outside the repo, drop them here.
assets-local/
source-assets/
*.psd
*.ai
*.sketch
*.fig
*.figma
*.xd

# --- Deployment -----------------------------------------------------------
.vercel
.netlify
.wrangler